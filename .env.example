# 问学 · 环境变量
#
# ★ 复制这个文件成 .env 再填密钥：
#     cp .env.example .env
#
#   .env 在 .gitignore 里，不会被提交。
#   服务端只把它当上游凭据用，**永远不会下发给浏览器** ——
#   前端调的是本机的 /api/chat，密钥只存在于服务端进程的内存里。

# ---------------------------------------------------------------
# DeepSeek API Key（必填）
# ---------------------------------------------------------------
# 拿 key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------
# 上游地址与模型（一般不用改）
# ---------------------------------------------------------------
# 换成任何 OpenAI 兼容网关都行（本机 LM Studio / vLLM / 中转站）
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------
# 监听端口
# ---------------------------------------------------------------
PORT=5188

# 单次请求的上游超时（毫秒）
UPSTREAM_TIMEOUT=60000

# ---------------------------------------------------------------
# ★ 关于「.env 和环境变量谁说了算」
# ---------------------------------------------------------------
# 凭据类（*_API_KEY / *_TOKEN / *_SECRET / *_PASSWORD）：
#     **.env 为准**。
#     理由：本机 shell 里（~/.zshrc）常常导出着一个旧 key。
#     如果让环境变量优先，用户明明把新 key 写进了 .env，
#     服务端却全程在用旧的 —— 健康检查报「已配置」，每条消息却 401，
#     而报错里只有上游那句「your api key: ****b605 is invalid」，
#     看上去像 key 本身失效，根本查不到「用错了哪一把」。
#     两边不一致时，启动日志会大声说出来。
#
# 其余（PORT / HOST / 超时）：
#     环境变量为准（常规做法），这样 `PORT=5199 node server.js` 能用。
#
# 想临时换 key 又不想改文件：WENXUE_ENV_WINS=1 node server.js
# 想换一个配置文件路径：    WENXUE_ENV_FILE=/path/to/.env node server.js
